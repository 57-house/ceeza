# Copier ce fichier en .env à la racine du projet :
#   copy .env.example .env
#
# Puis remplacez IP_DU_PC par l'adresse IPv4 de votre PC (ipconfig).
# Redémarrez Expo après modification : npm start -- --clear

# Sync dev (npm run server) — obligatoire pour Expo Go sur téléphone physique
EXPO_PUBLIC_WS_URL=ws://192.168.1.100:8765

# Émulateur Android / web sur le même PC :
# EXPO_PUBLIC_WS_URL=ws://localhost:8765

# Port du serveur dev (optionnel, défaut 8765)
# WS_PORT=8765
